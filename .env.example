# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=sg-workshop
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300

# --- Langfuse (observability tracing — optional, agent starts without these) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=
# Required — tracing is gated on it. Omitting it disables tracing
LANGFUSE_HOST=https://agentmonitoring.pertamina.ai

# --- Jakarta workspace (managed SQL MCP over workshop_ai_platform.default) ---
# Optional — the agent starts without these, just without remote SQL tools.
# Credentials belong to a dedicated service principal; never commit real values.
DATABRICKS_JAKARTA_HOST=https://dbc-77e33eef-a7e4.cloud.databricks.com
DATABRICKS_JAKARTA_CLIENT_ID=
# Local only: run under a CLI profile when the workspace has no service
# principal yet. Unset in the deployed app, which has no profile.
DATABRICKS_JAKARTA_PROFILE=
DATABRICKS_JAKARTA_CLIENT_SECRET=

# --- Volume-backed wiki (OKF knowledge bundle in the Jakarta workspace) ---
# Optional — the agent starts without this, just without the /wiki/ tier.
# Reached over the Jakarta credentials above, so it needs no key of its own.
DATABRICKS_WIKI_VOLUME=/Volumes/workshop_ai_platform/default/agent_wiki
