# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300

# --- Langfuse (observability tracing — optional, agent starts without these) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Required — tracing is gated on it. Omitting it disables tracing
LANGFUSE_HOST=https://agentmonitoring.pertamina.ai

# --- Jakarta workspace (managed SQL MCP over workshop_ai_platform.example) ---
# Optional — the agent starts without these, just without remote SQL tools.
# Credentials belong to a dedicated service principal; never commit real values.
DATABRICKS_JAKARTA_HOST=https://dbc-86b2f2e8-b955.cloud.databricks.com
DATABRICKS_JAKARTA_CLIENT_ID=
DATABRICKS_JAKARTA_CLIENT_SECRET=
